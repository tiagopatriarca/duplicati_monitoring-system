# Configurações de Domínio e Conexão com Traefik Global Pré-Existente
DOMAIN_NAME=seu-dominio.com.br
LETSENCRYPT_EMAIL=seu-email@exemplo.com

# Nome da rede docker onde seu Traefik principal está rodando (ex: traefik_net, traefik-net, web, proxy)
TRAEFIK_NETWORK=traefik_net
CERT_RESOLVER=myresolver
TRAEFIK_ENTRYPOINT=websecure

# Configurações do Banco de Dados MySQL
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=duplicati_user
MYSQL_PASSWORD=duplicati_password_123
MYSQL_DB=duplicati_monitor

# Chave secreta da Aplicação Flask
SECRET_KEY=duplicati_super_secret_key_2026

# Porta da aplicação
PORT=5000
